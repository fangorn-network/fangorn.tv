:root { --bg:#0d0f14; --panel:#161a22; --line:#262c38; --fg:#e6e9ef; --dim:#8a93a6; --accent:#e50914; --ok:#2ecc71; --warn:#f1c40f; }
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.4 system-ui, sans-serif; }
button { font:inherit; cursor:pointer; border:1px solid var(--line); background:var(--panel); color:var(--fg); border-radius:8px; padding:.45em .8em; }
button:hover:not(:disabled) { border-color:var(--dim); }
button:disabled { opacity:.5; cursor:default; }
button.primary { background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600; }
button.ghost { background:transparent; border-style:dashed; color:var(--dim); }
button.on { border-color:var(--accent); color:#fff; }
input { font:inherit; background:#0b0d12; color:var(--fg); border:1px solid var(--line); border-radius:6px; padding:.4em .6em; }

.app { max-width:960px; margin:0 auto; padding:0 16px 60px; }
header { display:flex; align-items:center; gap:14px; padding:16px 0; border-bottom:1px solid var(--line); position:sticky; top:0; background:var(--bg); z-index:5; }
header h1 { font-size:20px; margin:0; }
header nav { display:flex; gap:6px; }
.spacer { flex:1; }
.addr { font-family:ui-monospace, monospace; color:var(--dim); border:1px solid var(--line); border-radius:20px; padding:.3em .8em; }
.err { background:#3a1417; border:1px solid var(--accent); color:#ffb3b8; padding:.6em 1em; border-radius:8px; margin-top:12px; cursor:pointer; }

.toolbar { display:flex; align-items:center; gap:10px; margin:18px 0; flex-wrap:wrap; }
.status { color:var(--warn); font-size:13px; }
.hint, .empty { color:var(--dim); font-size:13px; }

.series { border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:16px; background:var(--panel); }
.series-title { font-size:18px; font-weight:700; width:60%; margin-right:8px; }
.series h2 { margin:.1em 0 .4em; }
.season { margin:12px 0 4px; padding-left:10px; border-left:2px solid var(--line); }
.season h4 { margin:.4em 0; color:var(--dim); font-weight:600; }

.episode { display:flex; align-items:center; gap:8px; padding:6px 0; }
.episode input { flex:1; }
.episode .price { flex:0 0 90px; }
.epnum { font-family:ui-monospace, monospace; color:var(--accent); font-weight:700; min-width:34px; }
.file { font-size:13px; color:var(--dim); border:1px dashed var(--line); border-radius:6px; padding:.35em .6em; cursor:pointer; white-space:nowrap; }
.file:hover { color:var(--fg); }
.badge { font-size:11px; text-transform:uppercase; letter-spacing:.03em; border-radius:20px; padding:.2em .7em; }
.badge.pub { background:#123524; color:var(--ok); }
.badge.ready { background:#3a3413; color:var(--warn); }
.badge.empty { background:#22262f; color:var(--dim); }

.eps { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); gap:10px; }
.epcard { display:flex; flex-direction:column; align-items:flex-start; gap:4px; text-align:left; padding:12px; background:#0b0d12; }
.epcard:hover:not(:disabled) { border-color:var(--accent); }
.epcard .eptitle { font-weight:600; }
.epcard .epprice { color:var(--ok); font-size:13px; }

.player { border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:18px; background:#000; }
.player-head { display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:var(--panel); }
.owner { flex:1; max-width:420px; font-family:ui-monospace, monospace; }
