[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = git@github.com:fangorn-network/sond3r.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[pull]
	rebase = false
[branch "feat/ia"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/feat/ia
