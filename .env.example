# ── Server service key ────────────────────────────────────────────────────────
# REQUIRED unless READ_ONLY=1, and it must be STABLE across restarts.
#
# It never signs a user's on-chain tx (the publisher's browser wallet does) and
# never pins (the publisher's wallet signs the storage gate's challenge). But it
# IS the seed for every publisher's upload token, and that token is the only
# thing telling the shared access worker WHICH publisher is writing. A fresh key
# per boot re-derives every token at once and the worker stops recognising
# anybody.
#
# Boot refuses to start a publishing relay without one, rather than let that
# surface days later as a 401 from the worker. Rotating it deliberately is fine
# and needs no action from publishers — but WORKER_URL's worker must get the new
# UPLOAD_HMAC_SECRET in the same breath (see below).
ETH_PRIVATE_KEY=

# ── IPFS ──────────────────────────────────────────────────────────────────────
# PINATA_JWT is the ESCAPE HATCH, and it is OFF by default (blank). Set it and
# this relay pins straight to Pinata on YOUR account, bypassing the storage gate
# entirely — no challenge, no publisher signature, no dependency on the gate
# being up. That is what you want while debugging, or on a relay where you are
# the only publisher. Leave it blank anywhere else: with it set, every
# publisher's bytes are billed to you.
PINATA_JWT=
# NOT a secret and NOT optional — a dedicated gateway serves reads
# unauthenticated, and without one every namespace read falls back to ipfs.io,
# which rate-limits until /api/catalog gives up. Both relay kinds need it.
PINATA_GATEWAY=your-gateway.mypinata.cloud

# ── x402f payment rails (Arbitrum Sepolia) ────────────────────────────────────
FACILITATOR_URL=http://localhost:30333
# Handed to unattended buyers via GET /api/config. Must be reachable from OUTSIDE
# this host — agents have no vite proxy and no localhost of yours.
PUBLIC_FACILITATOR_URL=http://localhost:30333
# ── storage (the shared access worker) ────────────────────────────────────────
# REQUIRED unless READ_ONLY=1. The one Cloudflare Worker + R2 bucket that every
# publisher on this relay uploads to. It is YOUR Cloudflare account and YOUR R2
# bill: publishers set nothing up and pay nothing for storage.
#
# The worker is webworker/fangorn-access-worker. Deploy it once, then give it the
# secret that makes this relay's upload tokens verifiable:
#
#   wrangler secret put UPLOAD_HMAC_SECRET
#     → keccak256(utf8("sond3r:upload-token:" + ETH_PRIVATE_KEY))
#   wrangler secret put WORKER_X25519_SECRET      # 32 bytes of hex; pin it
#
# Without UPLOAD_HMAC_SECRET the worker refuses every upload — deliberately: it
# would otherwise be an open write endpoint on a bucket you pay for. The two
# values must match or every publish 401s. Both are `wrangler secret`, not vars.
#
# Changing this later is safe. Buyers never read it — every workerUrl a buyer
# needs rides on the file's own on-chain pointer — so files already published go
# on serving from wherever they were published to.
#
# Bring-your-own-storage (a publisher provisioning a bucket into their OWN
# Cloudflare account from a pasted API token) is gone for now; it lived in
# server/cloudflare.js and is in git if it comes back. There is still no quota
# and nothing to sell: SHARED_QUOTA_BYTES, SHARED_QUOTA_TOTAL_BYTES,
# BILLING_ADDRESS, STORAGE_PRICE_PER_GB and UPLOAD_TOKEN are all gone.
WORKER_URL=

# Storage is for registered Fangorn publishers (they sign up at fangorn.network).
# It is the ONLY gate on the shared bucket now, so leave it on anywhere real.
# Set 0 only for tests, or against a chain where nobody is registered.
REQUIRE_PUBLISHER_REGISTRATION=

SETTLEMENT_REGISTRY_ADDR=0x480d54411d77820701fd80f42b81fb6e20176d12
USDC_CONTRACT_ADDR=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
USDC_DOMAIN_NAME="USD Coin"
VITE_CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# The RPC the SERVER's chain reads go through, including the SDK's own client.
# Unset, it falls back to VITE_CHAIN_RPC_URL and then to the SDK default.
# USE A REAL ENDPOINT (Alchemy/Infura/QuickNode). Reading a namespace, the catalog
# or a remote library is a StateCommitted getLogs from block 0, and the public
# sepolia-rollup endpoint answers that with "-32000 internal server errror" under
# any load at all — which reads as the whole storefront being down.
#
# A METERED KEY IS NOT ENOUGH ON ITS OWN. Free tiers cap historical range —
# Alchemy's refuses eth_getLogs over more than 10 blocks with "JSON is not a valid
# request object" — and buying rebuilds the Semaphore group with a from-block-0
# scan, so on a free key alone nobody can purchase anything. Both viem clients
# (src/wallet.js, server/index.js) therefore fall back to sepolia-rollup for the
# calls a metered provider refuses. Nothing to configure; just don't expect the
# key here to be the only endpoint that gets used.
CHAIN_RPC_URL=

# ── agent buyer (agent/buy.mjs) ───────────────────────────────────────────────
# The agent's OWN wallet. Needs test USDC; needs no ETH — the facilitator relays
# the transfer, the agent only signs an EIP-3009 authorization.
AGENT_PRIVATE_KEY=0x...
# Refuse to sign for more than this (base units). Nobody is watching it spend.
AGENT_MAX_SPEND=1000000

# Default episode price in USDC base units (6 decimals). 1000 = 0.001 USDC.
RESOURCE_PRICE=1000

# The on-chain app id whose catalog this relay serves. Default `sond3r`. It must
# already be registerApp'd — boot exits with the exact `cast send` if it isn't.
# Set it to a separately-registered app to get an isolated (empty) catalog for
# testing: libraries are keyed app:publisher:media, so a different app id sees
# none of the default app's content. Published resourceIds are unaffected.
APP=

# The DataRegistry the SDK reads namespaces and commits from. Unset, it uses
# whichever deployment the pinned SDK shipped with — and that contract HAS been
# redeployed, so a newer `fangorn` CLI can register an app against an address this
# copy never reads. The symptom is nasty because nothing errors: `fangorn
# register-app` says "Already registered to you", boot says the same app is owned
# by 0x0, and a relay pointed at the wrong one serves an empty catalog (every
# publisher's commits are on the other contract). Match the CLI's value —
# `grep dataRegistryContractAddress` in its lib/config.js — whenever they differ.
DATA_REGISTRY_ADDR=

# ── two registries, both required to publish ──────────────────────────────────
# As of @fangorn-network/sdk 2026.08.18-dev, apps live in their own AppRegistry
# contract, not the DataRegistry — and publishing needs membership of BOTH:
#
#   DataRegistry.register()        global standing: "this wallet may publish"
#   AppRegistry.registerForApp()   membership of THIS app: "…and under this one"
#
# commitStateRoot cross-calls the second, so a wallet with only the first reverts
# `NotRegisteredForApp` at commit time — after the encrypt and upload are paid
# for. GET /api/registration returns both unsigned txs, in order.
#
# An app must be CLAIMED, WITH TERMS, before anyone can join it: registerForApp
# reverts on an app whose terms hash is zero, so claiming with a zero digest
# makes an app only its owner can ever publish under. Both are checked at boot.
#
#   cast send <appRegistry> "registerApp(bytes32,bytes32,string,uint256)" \
#     <appId> <sha256 of public/terms.html> "https://<host>/terms.html" 0 \
#     --rpc-url $CHAIN_RPC_URL --private-key <key>
#
# The addresses ship in the SDK's FangornConfig; override only to point at a
# different deployment. THESE CHANGED in 2026.08.18-dev — a relay left on the old
# DataRegistry address reads a contract the new AppRegistry knows nothing about.
APP_REGISTRY_ADDR=

# Where buyers actually reach this storefront, e.g. app.sond3r.com (bare host is
# fine — https:// is added). The publisher's "This file"/"Permalink" share links
# and the embed <iframe> are built against it, so a publisher running a relay
# locally still hands out links to the hosted copy. Unset, links use whatever
# origin the page was loaded from.
DOMAIN=

# ── search (quickbeam view) ───────────────────────────────────────────────────
# The view whose shards the storefront searches and browses. Create one at
# https://fangorn.network (Embeddings → name it, add publisher + namespace `media`)
# and paste the URL it prints — the base, or the /stream or /cdn form, all work:
#   https://quickbeam-registry.quickbeam.workers.dev/q/qb_<wallet8>_<name>
# Handed to the browser by GET /api/config, so it is a RUNTIME value: repointing a
# relay at another view is a restart, not an image rebuild. The registry serves it
# with CORS *, so the browser pulls shards straight from the CDN, never through us.
#
# Unset, search returns nothing and browsing falls back to /api/catalog — a getLogs
# from block 0 plus an IPFS walk per publisher, on every cold viewer.
#
# No live view? Serve an exported embeddings bundle instead — same routes, same
# wire shape, real vectors, no registry:
#   node scripts/serve-embeddings.js archive-videos-test-1.embeddings.ndjson
#   QUICKBEAM_URL=http://localhost:8090
QUICKBEAM_URL=

# Which of that view's domains the browser downloads. Comma-separated; unset
# pulls every domain the view lists, which is the default and usually right.
#
# Set it when a view still watches a corpus you are no longer showing. A view
# fuses every watched (owner, namespace), so an old test collection left watched
# beside the current one is downloaded, parsed and clustered in every visitor's
# tab — twice the bytes and twice the work for rows that are not on screen.
# Filtered domains are skipped before their manifest is fetched, so they cost
# nothing at all.
#
# Matched by full name, by the namespace half of `<owner>/<namespace>`, or as a
# prefix. A value that matches no domain loads NOTHING rather than falling back
# to everything — a typo must not look like it worked.
#
#   QUICKBEAM_DOMAINS=archive.videos.test.2
QUICKBEAM_DOMAINS=

# The view that bakes the `apps` namespace — one row per registered app, keyed
# `apps:<0xwallet>:<appName>`, each carrying that app's manifest and the URL of its
# own view. Set it and the viewer gets an app picker; unset, it shows QUICKBEAM_URL
# only.
#
# This is NOT the app registry — that is AppRegistry on-chain, which holds appId,
# owner, terms and fee. The manifest is the off-chain half: everything the contract
# has nowhere to put.
APPS_VIEW_URL=

# ── read relay ────────────────────────────────────────────────────────────────
# 1 = pure storefront: catalog/config/remote + the SPA, and NOTHING that writes
# to disk (sign-in included). REQUIRED on any publicly reachable deploy — there
# is no publisher allowlist, so without it any wallet can stage files on you.
# Leave unset on a publisher's own machine.
READ_ONLY=

# ── publisher rights attestations ─────────────────────────────────────────────
# Append-only JSONL of every signed sign-in: address, the exact message, the
# signature, the timestamp. This is the compliance record behind public/terms.html
# — each line verifies on its own with no help from this server. Sign-in FAILS if
# it can't be written, so on a container this wants a mounted volume, not the
# ephemeral layer. Default: ./attestations.jsonl (gitignored). Back it up.
ATTESTATION_LOG=

# These are surfaced to the browser (vite exposes VITE_* only).
# Proxied by vite (target = FACILITATOR_URL above) to dodge CORS. Only set this
# to an absolute URL if that origin actually returns Access-Control-Allow-Origin.
VITE_FACILITATOR_URL=/facilitator
VITE_SETTLEMENT_REGISTRY_ADDR=0x480d54411d77820701fd80f42b81fb6e20176d12
VITE_USDC_CONTRACT_ADDR=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
VITE_USDC_DOMAIN_NAME="USD Coin"

# Optional. Set it and the header gains an email/social sign-in that mints an
# embedded wallet; leave it blank and no Privy code mounts at all and the app is
# injected-wallet-only, exactly as before. Buyers need no gas either way (they
# only sign), so an embedded wallet can buy and watch with a 0 ETH balance.
# Publishers still need a funded account to send createResource/commitStateRoot.
# Get an app id at https://dashboard.privy.io — allow this origin in its settings.
VITE_PRIVY_APP_ID=

# The key quorum the SOND3R bot signs with, from the Privy dashboard →
# Wallet infrastructure → Authorization keys. An id, not a secret: it is compiled
# into the mini app, where "Enable one-tap buying" grants it a session signer on
# the user's wallet. Its private half is PRIVY_AUTHORIZATION_KEY in the bot's env.
# Unset → the mini app says one-tap buying isn't configured and buying in the
# webview still works.
VITE_PRIVY_SIGNER_ID=
