// (viem + Semaphore), talking to the facilitator/worker directly. /api is the
// only thing proxied to the local server.
export default defineConfig({
    plugins: [react()],
    server: {
        proxy: {
            "/api": { target: "http://localhost:8787", changeOrigin: true },
        },
    },
});
