import React, { useEffect, useState } from "react";
import { connectWallet, publicClient } from "./wallet.js";
import { api } from "./api.js";
import { watchEpisode } from "./purchase.js";

const uid = () => Math.random().toString(36).slice(2, 8);
const usdc = (base) => `${(Number(base) / 1e6).toFixed(3)} USDC`;

export default function App() {
    const [wallet, setWallet] = useState(null); // { address, walletClient }
    const [tab, setTab] = useState("publish");
    const [err, setErr] = useState(null);

    const connect = async () => {
        try { setErr(null); setWallet(await connectWallet()); }
        catch (e) { setErr(e.message); }
    };

    return (
        <div className="app">
            <header>
                <h1>🎬 fttf-flix</h1>
                <nav>
                    <button className={tab === "publish" ? "on" : ""} onClick={() => setTab("publish")}>Publisher</button>
                    <button className={tab === "watch" ? "on" : ""} onClick={() => setTab("watch")}>Watch</button>
                </nav>
                <div className="spacer" />
                {wallet
                    ? <span className="addr" title={wallet.address}>{wallet.address.slice(0, 6)}…{wallet.address.slice(-4)}</span>
                    : <button className="primary" onClick={connect}>Connect wallet</button>}
            </header>
            {err && <div className="err" onClick={() => setErr(null)}>{err} ✕</div>}
            {tab === "publish"
                ? <Publisher wallet={wallet} onError={setErr} />
                : <Viewer wallet={wallet} onError={setErr} />}
        </div>
    );
}

// ─── Publisher portal ─────────────────────────────────────────────────────────
function Publisher({ wallet, onError }) {
    const [cat, setCat] = useState({ series: [] });
    const [defaultPrice, setDefaultPrice] = useState("1000");
    const [status, setStatus] = useState(null);
    const [busy, setBusy] = useState(false);

    useEffect(() => { api.getCatalog().then((r) => { setCat(r.catalog); setDefaultPrice(r.defaultPrice); }).catch((e) => onError(e.message)); }, []);

    // Persist working catalog on every structural edit.
    const save = async (next) => { setCat(next); try { await api.saveCatalog(next); } catch (e) { onError(e.message); } };
    const mutate = (fn) => { const next = structuredClone(cat); fn(next); return save(next); };

    const addSeries = () => mutate((c) => c.series.push({ id: `sr-${uid()}`, title: "New series", seasons: [] }));
    const addSeason = (s) => mutate((c) => {
        const sr = c.series.find((x) => x.id === s.id);
        sr.seasons.push({ id: `${s.id}-se-${uid()}`, number: (sr.seasons.length + 1), title: `Season ${sr.seasons.length + 1}`, episodes: [] });
    });
    const addEpisode = (s, se) => mutate((c) => {
        const season = c.series.find((x) => x.id === s.id).seasons.find((x) => x.id === se.id);
        season.episodes.push({ id: `${se.id}-ep-${uid()}`, number: season.episodes.length + 1, title: `Episode ${season.episodes.length + 1}`, price: defaultPrice });
    });
    const setField = (epId, key, val) => mutate((c) => {
        for (const s of c.series) for (const se of s.seasons) for (const ep of se.episodes) if (ep.id === epId) ep[key] = val;
    });
    const setSeriesTitle = (id, title) => mutate((c) => { c.series.find((x) => x.id === id).title = title; });

    const upload = async (ep, file) => {
        try { setStatus(`uploading ${file.name}…`); await api.uploadMp4(ep.id, file); const r = await api.getCatalog(); setCat(r.catalog); setStatus(null); }
        catch (e) { onError(e.message); setStatus(null); }
    };

    const publish = async () => {
        if (!wallet) return onError("Connect your wallet first.");
        setBusy(true);
        try {
            setStatus("preparing (encrypt + upload new episodes)…");
            const prep = await api.preparePublish(wallet.address);
            let i = 0;
            for (const c of prep.creates) {
                setStatus(`createResource ${++i}/${prep.creates.length}…`);
                const h = await wallet.walletClient.sendTransaction({ to: c.to, data: c.data });
                await publicClient.waitForTransactionReceipt({ hash: h });
            }
            setStatus("committing library graph…");
            const h = await wallet.walletClient.sendTransaction({ to: prep.commitTx.to, data: prep.commitTx.data });
            await publicClient.waitForTransactionReceipt({ hash: h });
            await api.settlePublish(prep.published);
            const r = await api.getCatalog(); setCat(r.catalog);
            setStatus(`published — ${prep.staged.vertices} vertices, ${prep.staged.edges} edges ✓`);
        } catch (e) { onError(e.message); setStatus(null); }
        finally { setBusy(false); }
    };

    const unpublished = cat.series.some((s) => s.seasons.some((se) => se.episodes.some((ep) => ep.file && !ep.published)));

    return (
        <main className="publisher">
            <div className="toolbar">
                <button onClick={addSeries}>+ Series</button>
                <button className="primary" disabled={busy} onClick={publish}>Publish to Fangorn</button>
                {status && <span className="status">{status}</span>}
            </div>
            {cat.series.length === 0 && <p className="empty">No series yet. Add one to get started.</p>}
            {cat.series.map((s) => (
                <section key={s.id} className="series">
                    <input className="series-title" value={s.title} onChange={(e) => setSeriesTitle(s.id, e.target.value)} />
                    <button className="ghost" onClick={() => addSeason(s)}>+ Season</button>
                    {s.seasons.map((se) => (
                        <div key={se.id} className="season">
                            <h4>Season {se.number}: {se.title}</h4>
                            <button className="ghost" onClick={() => addEpisode(s, se)}>+ Episode</button>
                            {se.episodes.map((ep) => (
                                <div key={ep.id} className="episode">
                                    <span className="epnum">E{ep.number}</span>
                                    <input value={ep.title} onChange={(e) => setField(ep.id, "title", e.target.value)} />
                                    <input className="price" value={ep.price} onChange={(e) => setField(ep.id, "price", e.target.value)} title="price (USDC base units)" />
                                    <label className="file">
                                        {ep.file ? "↻ replace mp4" : "＋ mp4"}
                                        <input type="file" accept="video/mp4" hidden onChange={(e) => e.target.files[0] && upload(ep, e.target.files[0])} />
                                    </label>
                                    <span className={`badge ${ep.published ? "pub" : ep.file ? "ready" : "empty"}`}>
                                        {ep.published ? "published" : ep.file ? "ready" : "no file"}
                                    </span>
                                </div>
                            ))}
                        </div>
                    ))}
                </section>
            ))}
            {unpublished && <p className="hint">Episodes marked “ready” will be encrypted, uploaded and priced on publish.</p>}
        </main>
    );
}

// ─── Viewer / storefront ──────────────────────────────────────────────────────
function Viewer({ wallet, onError }) {
    const [owner, setOwner] = useState("");
    const [cat, setCat] = useState(null);
    const [status, setStatus] = useState(null);
    const [videoUrl, setVideoUrl] = useState(null);
    const [nowPlaying, setNowPlaying] = useState(null);

    useEffect(() => { if (wallet && !owner) setOwner(wallet.address); }, [wallet]);

    const load = async () => {
        try { setStatus("loading catalog…"); const r = await api.getRemote(owner); setCat(r.catalog); setStatus(null); }
        catch (e) { onError(e.message); setStatus(null); }
    };

    const play = async (ep) => {
        if (!wallet) return onError("Connect your wallet to buy/watch.");
        try {
            setNowPlaying(ep); setVideoUrl(null);
            const bytes = await watchEpisode({
                walletClient: wallet.walletClient, publicClient, episode: ep, owner,
                onStage: setStatus,
            });
            const url = URL.createObjectURL(new Blob([bytes], { type: "video/mp4" }));
            setVideoUrl(url); setStatus(null);
        } catch (e) { onError(e.message); setStatus(null); setNowPlaying(null); }
    };

    return (
        <main className="viewer">
            <div className="toolbar">
                <input className="owner" placeholder="publisher address 0x…" value={owner} onChange={(e) => setOwner(e.target.value)} />
                <button className="primary" onClick={load} disabled={!/^0x[0-9a-fA-F]{40}$/.test(owner)}>Load</button>
                {status && <span className="status">{status}</span>}
            </div>

            {videoUrl && (
                <div className="player">
                    <div className="player-head"><b>{nowPlaying?.title}</b><button className="ghost" onClick={() => { URL.revokeObjectURL(videoUrl); setVideoUrl(null); setNowPlaying(null); }}>✕ close</button></div>
                    <video src={videoUrl} controls autoPlay style={{ width: "100%" }} />
                </div>
            )}

            {cat?.series?.length === 0 && <p className="empty">Nothing published at this address yet.</p>}
            {cat?.series?.map((s) => (
                <section key={s.id} className="series">
                    <h2>{s.title}</h2>
                    {s.seasons.map((se) => (
                        <div key={se.id} className="season">
                            <h4>Season {se.number}: {se.title}</h4>
                            <div className="eps">
                                {se.episodes.map((ep) => (
                                    <button key={ep.id} className="epcard" onClick={() => play(ep)} disabled={!!status}>
                                        <span className="epnum">E{ep.number}</span>
                                        <span className="eptitle">{ep.title}</span>
                                        <span className="epprice">{usdc(ep.price)}</span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    ))}
                </section>
            ))}
        </main>
    );
}
